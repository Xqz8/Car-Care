<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_light">

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/blue_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="💸 Add Expense"
                android:textColor="@color/blue_dark"
                android:textSize="26sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textColor="@color/gray_dark"
                    android:layout_marginBottom="6dp"/>

                <Spinner android:id="@+id/spinnerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/rounded_edittext"
                    android:entries="@array/expense_categories"
                    android:layout_marginBottom="14dp"/>

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount (₱)"
                    android:textColor="@color/gray_dark"
                    android:layout_marginBottom="6dp"/>

                <EditText android:id="@+id/etAmount"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="0.00"
                    android:background="@drawable/rounded_edittext"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="14dp"/>

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textColor="@color/gray_dark"
                    android:layout_marginBottom="6dp"/>

                <EditText android:id="@+id/etDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="YYYY-MM-DD"
                    android:background="@drawable/rounded_edittext"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_marginBottom="14dp"/>

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Odometer Reading (km)"
                    android:textColor="@color/gray_dark"
                    android:layout_marginBottom="6dp"/>

                <EditText android:id="@+id/etOdometer"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="e.g. 25000"
                    android:background="@drawable/rounded_edittext"
                    android:inputType="number"
                    android:layout_marginBottom="14dp"/>

                <!-- Fuel-specific fields — hidden unless Fuel category is selected -->
                <LinearLayout
                    android:id="@+id/layoutFuelFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Liters Filled"
                        android:textColor="@color/gray_medium"
                        android:layout_marginTop="12dp"/>

                    <EditText
                        android:id="@+id/etLiters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 10.5 (optional)"
                        android:inputType="numberDecimal"
                        android:background="@drawable/rounded_edittext"
                        android:padding="12dp"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Price per Liter (auto-calculated)"
                        android:textColor="@color/gray_medium"
                        android:layout_marginTop="12dp"/>

                    <EditText
                        android:id="@+id/etPricePerLiter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="₱ per liter"
                        android:focusable="false"
                        android:background="@drawable/rounded_edittext"
                        android:padding="12dp"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvEfficiencyPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/blue_primary"
                        android:layout_marginTop="6dp"/>

                </LinearLayout>


                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notes (optional)"
                    android:textColor="@color/gray_dark"
                    android:layout_marginBottom="6dp"/>

                <EditText android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:hint="Any notes about this expense..."
                    android:background="@drawable/rounded_edittext"
                    android:gravity="top"
                    android:layout_marginBottom="24dp"/>

                <Button android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Save Expense"
                    android:textColor="@color/white"
                    android:background="@drawable/rounded_button_blue"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>